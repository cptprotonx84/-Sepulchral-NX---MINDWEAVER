{
  "name": "sepulchral-nx-mindweaver",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "npm run build && npm start",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run lint && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "desktop:run": "npm run build && electron .",
    "desktop:portable": "npm run build && electron-builder --win portable --x64",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "nx.sepulchral.mindweaver",
    "productName": "Mindweaver",
    "directories": {"output": "release"},
    "asar": true,
    "files": [
      "dist/**",
      "!dist/server.cjs*",
      "electron/**",
      "assets/icon/mindweaver.ico",
      "package.json"
    ],
    "win": {"icon": "assets/icon/mindweaver.ico", "target": [{"target": "portable", "arch": ["x64"]}]},
    "portable": {"artifactName": "Mindweaver-Desktop-${version}-${arch}.${ext}"}
  }
}
